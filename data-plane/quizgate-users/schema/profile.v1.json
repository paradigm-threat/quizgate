{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.quizgate.app/schema/profile.v1.json",
  "title": "QuizGate user profile",
  "type": "object",
  "required": ["schema", "user_uuid", "updated_at_ms", "curriculum_id"],
  "properties": {
    "schema": { "const": "quizgate.user.profile.v1" },
    "user_uuid": { "type": "string", "format": "uuid" },
    "updated_at_ms": { "type": "integer" },
    "curriculum_id": { "type": "string" },
    "readiness": {
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "next_curriculum_id": { "type": ["string", "null"] },
        "next_level": { "type": ["integer", "null"] },
        "level_up": { "type": "object" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "interval_ms": { "type": "integer" },
        "jitter_ms": { "type": "integer" },
        "performance_preference": {
          "type": "string",
          "enum": ["auto", "performance", "slim"]
        },
        "time_earn_cap_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180,
          "description": "Rapid-fire time-earn per-session cap (default 120)"
        },
        "curriculum_level": {
          "type": "integer",
          "minimum": 0,
          "description": "Active curriculum progression level (default 0)"
        },
        "level_up_min_accuracy_pct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Soft gate: min right/(right+wrong) % (default 75)"
        },
        "level_up_min_correct": {
          "type": "integer",
          "minimum": 1,
          "description": "Soft gate: min correct count (default 5)"
        },
        "level_up_max_skip_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional soft gate: max skipped/asked %. Omit for default skipped≤right+wrong"
        },
        "stats_day_barrier_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "Local hour when stats day rolls (default 5)"
        }
      }
    },
    "content_hints": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
