<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/quiz_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="88dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/header"
            android:textColor="@color/header"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Question “balloon”: inflate / relax pulse -->
        <LinearLayout
            android:id="@+id/question_balloon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/spoken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/header"
                android:textSize="28sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/symbolic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/symbolic"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/digit_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent_dark"
                android:textSize="44sp"
                android:textStyle="bold"
                android:gravity="center"
                android:minHeight="56dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/choices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:id="@+id/digit_pad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Today's stats — pinned to screen bottom, away from keypad -->
    <LinearLayout
        android:id="@+id/quiz_stats_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/stats_card_ready"
        android:elevation="4dp">

        <TextView
            android:id="@+id/quiz_stats_mood"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/stats_mood_ready"
            android:textColor="@color/stats_mood_ready"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/quiz_stats_asked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 questions"
            android:textColor="@color/header"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/quiz_stats_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 right"
            android:textColor="@color/stats_mood_great"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end|center_vertical"/>
    </LinearLayout>

    <!-- Full-screen wrong / success / consoling transition -->
    <FrameLayout
        android:id="@+id/transition_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/photo_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/photo_overlay_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null"/>

        <!-- Scrim so text stays readable on busy photos -->
        <View
            android:id="@+id/transition_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"/>

        <FrameLayout
            android:id="@+id/confetti_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/transition_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            android:background="@drawable/transition_text_plate">

            <TextView
                android:id="@+id/transition_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/transition_title"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"/>

            <TextView
                android:id="@+id/transition_retry_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/retry_in"
                android:textColor="@color/transition_body"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"/>

            <TextView
                android:id="@+id/transition_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="96dp"
                android:gravity="center"
                android:textColor="@color/transition_countdown"
                android:textSize="72sp"
                android:textStyle="bold"
                android:shadowColor="#A0000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="8"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
