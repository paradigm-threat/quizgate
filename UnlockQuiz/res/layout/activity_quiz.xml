<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Soft local-gallery backdrop (scrim keeps quiz readable) -->
    <ImageView
        android:id="@+id/quiz_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <View
        android:id="@+id/quiz_bg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9F7F1E8"/>

    <!-- 2D pan host: drag the question/answers anywhere; snap-back keeps
         critical controls recoverable if panned too far off-screen. -->
    <net.clevertree.quizgate.QuizPanView
        android:id="@+id/quiz_pan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp">

        <!-- No host/panel padding: nested pads made portrait narrow and let the
             pan clamp shove the question off-screen under the stats bar. -->
        <LinearLayout
            android:id="@+id/quiz_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="0dp">

            <TextView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/header"
                android:textColor="@color/header"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- Question “balloon”: inflate / relax pulse -->
            <LinearLayout
                android:id="@+id/question_balloon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="0dp">

                <TextView
                    android:id="@+id/spoken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/header"
                    android:textSize="28sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/symbolic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/symbolic"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/digit_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/accent_dark"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/choices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/digit_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="0dp"
                android:visibility="gone"/>

            <!-- Available for every ask format; counts as a skip then shows another. -->
            <TextView
                android:id="@+id/btn_skip_question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/quiz_skip"
                android:textColor="@color/header"
                android:textSize="16sp"
                android:alpha="0.72"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/quiz_skip_cd"/>
        </LinearLayout>
    </net.clevertree.quizgate.QuizPanView>

    <!-- Today's stats — opposite end from the initial UI anchor. -->
    <LinearLayout
        android:id="@+id/quiz_stats_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/stats_card_ready"
        android:elevation="4dp">

        <TextView
            android:id="@+id/quiz_stats_mood"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="@string/stats_mood_ready"
            android:textColor="@color/stats_mood_ready"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/quiz_stats_asked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:text="0 asked"
            android:textColor="@color/header"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/quiz_stats_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:text="0 right"
            android:textColor="@color/stats_mood_great"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/quiz_stats_wrong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:text="0 wrong"
            android:textColor="@color/stats_mood_trying"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/quiz_stats_skipped"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:text="0 skipped"
            android:textColor="@color/header"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end|center_vertical"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Full-screen wrong / success / consoling transition -->
    <FrameLayout
        android:id="@+id/transition_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/photo_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/photo_overlay_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null"/>

        <!-- Scrim so text stays readable on busy photos -->
        <View
            android:id="@+id/transition_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"/>

        <FrameLayout
            android:id="@+id/confetti_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/transition_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            android:background="@drawable/transition_text_plate">

            <ImageView
                android:id="@+id/transition_gate_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/quizgate_splash_icon"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/transition_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/transition_title"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"/>

            <TextView
                android:id="@+id/transition_play_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/play_success_prompt"
                android:textColor="@color/transition_body"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"/>

            <LinearLayout
                android:id="@+id/transition_play_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_earn_more_time"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/success"
                    android:text="@string/play_earn_more_time"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_ask_another"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/accent"
                    android:text="@string/play_ask_another"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btn_quit_play"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/symbolic"
                    android:text="@string/play_quit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"/>

                <Button
                    android:id="@+id/btn_view_stats"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/accent_dark"
                    android:text="@string/play_view_stats"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btn_play_parents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="8dp"
                    android:text="@string/play_parents"
                    android:textColor="@color/transition_body"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/transition_retry_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/retry_in"
                android:textColor="@color/transition_body"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"/>

            <TextView
                android:id="@+id/transition_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="96dp"
                android:gravity="center"
                android:textColor="@color/transition_countdown"
                android:textSize="72sp"
                android:textStyle="bold"
                android:shadowColor="#A0000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="8"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Historic stats — in-process overlay (QuizActivity is singleInstance).
         Elevation must beat quiz_stats_bar (4dp) so the bar cannot paint through. -->
    <FrameLayout
        android:id="@+id/stats_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:elevation="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>
</FrameLayout>
