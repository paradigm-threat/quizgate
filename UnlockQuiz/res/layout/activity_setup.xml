<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/quizgate_splash_icon"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_title"
            android:textColor="@color/header"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/setup_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_body"
            android:textColor="@color/header"
            android:textSize="17sp"
            android:gravity="center"/>

        <!-- Today's stats -->
        <LinearLayout
            android:id="@+id/stats_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal"
            android:background="@drawable/stats_card_ready">

            <TextView
                android:id="@+id/stats_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_today_title"
                android:textColor="@color/header"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/stats_mood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/stats_mood_ready"
                android:textColor="@color/stats_mood_ready"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stats_asked_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/header"
                        android:textSize="36sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_asked_label"
                        android:textColor="@color/header"
                        android:textSize="13sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stats_right_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/stats_mood_great"
                        android:textSize="36sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_right_label"
                        android:textColor="@color/header"
                        android:textSize="13sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stats_wrong_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/stats_mood_trying"
                        android:textSize="36sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_wrong_label"
                        android:textColor="@color/header"
                        android:textSize="13sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stats_skipped_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/header"
                        android:textSize="36sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_skipped_label"
                        android:textColor="@color/header"
                        android:textSize="13sp"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/minutes_jar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/header"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="Minutes jar: 0"/>

        <TextView
            android:id="@+id/setup_next_quiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_next_quiz_unarmed"
            android:textColor="@color/symbolic"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_schedule_label"
            android:textColor="@color/header"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_interval_label"
            android:textColor="@color/header"
            android:textSize="14sp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_setup_interval_minus"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/symbolic"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/setup_interval_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/header"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_setup_interval_plus"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/symbolic"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_jitter_label"
            android:textColor="@color/header"
            android:textSize="14sp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_setup_jitter_minus"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/symbolic"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/setup_jitter_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/header"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_setup_jitter_plus"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/symbolic"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/setup_window_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/symbolic"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/setup_curriculum_label"
            android:textColor="@color/header"
            android:textSize="14sp"
            android:gravity="center"/>

        <Spinner
            android:id="@+id/curriculum_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_tier_label"
            android:textColor="@color/header"
            android:textSize="14sp"
            android:gravity="center"/>

        <Spinner
            android:id="@+id/tier_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"/>

        <CheckBox
            android:id="@+id/sync_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_sync_label"
            android:textColor="@color/header"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btn_sync_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/setup_sync_now"
            android:textSize="16sp"
            android:backgroundTint="@color/symbolic"
            android:textColor="#FFFFFF"/>

        <LinearLayout
            android:id="@+id/setup_req_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/setup_req_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_req_title"
                android:textColor="@color/header"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setup_req_intro"
                android:textColor="@color/header"
                android:textSize="14sp"
                android:gravity="center"/>

            <LinearLayout
                android:id="@+id/setup_req_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"/>
        </LinearLayout>

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/symbolic"
            android:textSize="13sp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btn_arm"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="@string/setup_arm"
            android:textSize="20sp"
            android:backgroundTint="@color/accent"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btn_force"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/setup_force"
            android:textSize="20sp"
            android:backgroundTint="@color/symbolic"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btn_add_widget"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/setup_add_widget"
            android:textSize="17sp"
            android:backgroundTint="@color/symbolic"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>
